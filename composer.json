{
    "name": "jcr-labs/nextcloud-pto",
    "description": "PTO and vacation tracking for Nextcloud",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "JCR Labs",
            "email": "jim@sparerecords.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "nextcloud/coding-standard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\PTO\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\PTO\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
